# Variables de entorno para Pidoo Go
# Copiar a .env y completar con tus valores

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# App Configuration
VITE_APP_NAME=Pidoo Go
VITE_APP_VERSION=1.0.0

# Capacitor (para builds nativos)
CAPACITOR_ANDROID_STUDIO_PATH=/usr/local/android-studio
CAPACITOR_IOS_XCODE_PATH=/Applications/Xcode.app

# Build Configuration
VITE_BUILD_MODE=production